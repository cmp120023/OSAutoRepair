@model IEnumerable<OSAutoRepair.Models.ServiceCategory>

@{
    ViewData["Title"] = "O.S. Auto Repair | Reliable Local Auto Service";
}

<!-- Hero Section -->
<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-sm">
    <div class="container-fluid py-3">
        <span class="badge bg-warning text-dark mb-2">5-Bay Full-Service Workshop</span>
        <h1 class="display-5 fw-bold">O.S. Auto Repair</h1>
        <p class="col-md-8 fs-5 text-light">
            Honest, straightforward automotive maintenance and repair. Schedule your service online in seconds—no account required.
        </p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Book" class="btn btn-warning btn-lg fw-semibold px-4">
                Book an Appointment
            </a>
        </div>
    </div>
</div>

<!-- Shop Info Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold">Shop Hours</h5>
                <p class="card-text mb-1"><strong>Tuesday – Saturday:</strong> 9:00 AM – 5:00 PM</p>
                <p class="card-text mb-1 text-muted small"><strong>Sunday – Monday:</strong> Closed</p>
                <p class="card-text text-muted small mb-0">
                    Online appointments are scheduled in 1-hour blocks starting between 9:00 AM and 5:00 PM.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold">48-Hour Advance Booking</h5>
                <p class="card-text mb-1">Book at least <strong>2 days in advance</strong>.</p>
                <p class="card-text text-muted small mb-0">
                    Need urgent same-day assistance? Call the shop directly so our technicians can check bay availability.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold">Location &amp; Contact</h5>
                <p class="card-text mb-1"><strong>O.S. Auto Repair</strong></p>
                <p class="card-text mb-1">Phone: <a href="tel:2067622610" class="text-decoration-none">(206)762-2610</a></p>
                <p class="card-text mb-1">Address:
                    <a href="https://www.google.com/maps/@@47.469603,-122.3335491,103a,75y,88.3h,93.09t/data=!3m7!1e1!3m5!1sb49oIAFNqJjDZVKhJh9AsA!2e0!6shttps:%2F%2Fstreetviewpixels-pa.clients6.google.com%2Fv1%2Fthumbnail%3Fcb_client%3Dmaps_sv.tactile%26w%3D900%26h%3D600%26pitch%3D-3.085953933715132%26panoid%3Db49oIAFNqJjDZVKhJh9AsA%26yaw%3D88.30256767443093!7i16384!8i8192?entry=ttu&g_ep=EgoyMDI2MTEyMi4wIKXMDSoASAFQAw%3D%3D"
                         target="_blank"
                         rel="noopener noreferrer"
                         class="text-decoration-none">
                         14836 1st Ave S, Burien, WA 98168
                     </a></p>
                <p class="card-text text-muted small mb-0">
                    Personal, one-on-one service from drop-off to pickup.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Services Section -->
<div id="services" class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-0">Our Services</h2>
            <p class="text-muted mb-0">Select a service below to reserve a bay at least 2 days ahead.</p>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var service in Model)
            {
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="card-title fw-bold mb-0">@service.Name</h4>
                                <span class="badge bg-secondary">
                                    Est. @service.DefaultDurationHours @(service.DefaultDurationHours == 1 ? "hr" : "hrs")
                                </span>
                            </div>
                            <p class="card-text text-muted flex-grow-1">
                                @(service.Name.Equals("Oil", StringComparison.OrdinalIgnoreCase)
                                    ? "Routine oil and filter service to keep your engine protected and running smoothly."
                                    : "Comprehensive mechanical diagnostics and hands-on repair by our shop technicians.")
                            </p>
                            <div class="mt-3">
                                <a asp-controller="Home"
                                   asp-action="Book"
                                   asp-route-categoryId="@service.ServiceCategoryId"
                                   class="btn btn-primary w-100">
                                    Book @service.Name Appointment
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">
                    Online service listings are currently being updated. Please call the shop to schedule an appointment.
                </div>
            </div>
        }
    </div>
</div>
