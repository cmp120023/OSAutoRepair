@model OSAutoRepair.Models.Appointment

@{
    ViewData["Title"] = "Appointment Confirmed | O.S. Auto Repair";
    var startTime = DateTime.Today.AddHours(Model.StartHour).ToString("h:00 tt");
    var endTime = DateTime.Today.AddHours(Model.StartHour + Model.DurationHours).ToString("h:00 tt");
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mt-3">
            <div class="card-header bg-success text-white py-3">
                <h3 class="mb-0 fw-bold">Appointment Confirmed!</h3>
            </div>
            <div class="card-body p-4">
                <p class="lead mb-4">
                    Thank you, <strong>@Model.CustomerFirstName @Model.CustomerLastName</strong>. Your service appointment at <strong>O.S. Auto Repair</strong> has been scheduled.
                </p>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Confirmation #</dt>
                    <dd class="col-sm-8 fw-semibold">#@Model.AppointmentId</dd>

                    <dt class="col-sm-4 text-muted">Service</dt>
                    <dd class="col-sm-8 fw-semibold">@(Model.ServiceCategory?.Name ?? "Auto Service")</dd>

                    <dt class="col-sm-4 text-muted">Date</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.AppointmentDate.ToString("dddd, MMMM d, yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Time Window</dt>
                    <dd class="col-sm-8 fw-semibold">@startTime – @endTime (@Model.DurationHours @(Model.DurationHours == 1 ? "hr" : "hrs"))</dd>

                    <dt class="col-sm-4 text-muted">Estimated Cost</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.EstimatedCost.ToString("C")</dd>

                    <dt class="col-sm-4 text-muted">Phone</dt>
                    <dd class="col-sm-8">@Model.CustomerPhone</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                    {
                        <dt class="col-sm-4 text-muted">Email</dt>
                        <dd class="col-sm-8">@Model.CustomerEmail</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.CustomerServiceNotes))
                    {
                        <dt class="col-sm-4 text-muted">Your Notes</dt>
                        <dd class="col-sm-8">@Model.CustomerServiceNotes</dd>
                    }
                </dl>

                <div class="alert alert-light border small text-muted mb-4">
                    Need to reschedule or update your notes? Please call O.S. Auto Repair directly at <strong>(555) 019-2834</strong>.
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        Back to Home
                    </a>
                    <a asp-controller="Home" asp-action="Book" class="btn btn-primary">
                        Book Another Appointment
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
